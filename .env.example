# Copie para .env e preencha. Nunca versione o arquivo .env.
AMBIENTE=desenvolvimento

# PostgreSQL local ou URL do Neon/Vercel Postgres (com ?sslmode=require em produção)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sistemavendas

# Obrigatório na Vercel (mínimo 32 caracteres). Use um valor diferente em cada ambiente.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Imagens de produtos (Vercel Blob, store PÚBLICO). Opcional localmente: sem ela, as imagens
# vão para public/uploads. Na Vercel, conectar o store ao projeto já configura o acesso.
BLOB_READ_WRITE_TOKEN=

# Protege a rota do Vercel Cron (/api/cron/liberar-reservas). Gere com secrets.token_urlsafe(32).
CRON_SECRET=

# Mercado Pago — use SOMENTE o Access Token de uma aplicação criada DENTRO da conta vendedora de teste.
MERCADOPAGO_ACCESS_TOKEN=
# true: modo de teste com token APP_USR- de conta de teste; o vendedor é verificado a cada cobrança.
MERCADOPAGO_MODO_TESTE=
# Assinatura secreta do webhook (Suas integrações > Webhooks > Configurar notificações).
MERCADOPAGO_WEBHOOK_SECRET=
# Focus NFe — token de HOMOLOGAÇÃO. Sem ele, os pedidos pagos ficam com a nota pendente.
FOCUSNFE_TOKEN=
# Valor enviado no header X-Webhook-Token ao criar o gatilho na Focus NFe. Gere com secrets.token_urlsafe(32).
FOCUSNFE_WEBHOOK_TOKEN=
# Resend — envio do DANFE e do XML por e-mail. Sem a chave, os documentos não são enviados.
RESEND_API_KEY=
EMAIL_REMETENTE=Lulora Tech <onboarding@resend.dev>
# Endereço público do site (URLs de retorno e notificação do Mercado Pago).
URL_PUBLICA=https://sistemavendas-sigma.vercel.app
# true: emissor de NF-e e e-mail SIMULADOS (sem Focus NFe nem Resend). Só funciona com AMBIENTE=testes
# e fora da Vercel; os e-mails vão para documentos/logs/emails-simulados.
NFE_SIMULADA=
